# Template for the per-mode Vite env files. Vite loads `.env.<mode>` for the mode given by
# `vite --mode` (see package.json / vercel.json):
#
#   .env.integrated   pnpm dev            → local backend on http://localhost:4000
#   .env.standalone   pnpm start:standalone → Apidog mock, no backend (no VAPID key needed)
#   .env.staging      CI_BUILD_ENV=staging  → GitHub Pages, .github/workflows/pages-release.yml
#   .env.production   CI_BUILD_ENV=production → Vercel, vercel.json
#
# These files are git-ignored, so CI builds must supply the variables themselves: Vite also inlines
# any VITE_-prefixed variable found in the build environment (GitHub Actions `env:` block, Vercel
# project settings). Values are baked into the bundle at build time, so none of them can be secret.

VITE_APP_API_ADDRESS=http://localhost:4000
# Subpath the app is served from, e.g. /k9x-frontend on GitHub Pages. Empty at a domain root.
VITE_APP_BASE_PATH=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173
# Must match VAPID_PUBLIC_KEY of the backend this build talks to, or push is rejected.
# See k9x-backend/docs/vapid-keys.md.
VITE_VAPID_PUBLIC_KEY=
